---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
// The other themes' type (tokens.json themes). A face is only fetched when a theme on screen uses it.
import "@fontsource-variable/sora";
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/comic-neue/400.css";
import "@fontsource/comic-neue/400-italic.css";
import "@fontsource/comic-neue/700.css";
import "@fontsource/comic-neue/700-italic.css";
import "~/styles/index.css";
import { ClientRouter } from "astro:transitions";
import Header from "~/components/ui/Header.astro";
import ChapterRuler from "~/components/ui/ChapterRuler.astro";
import Footer from "~/components/ui/Footer.astro";
import { pageCut } from "~/motion/patterns";
import { themes } from "~/motion/tokens";

interface Props {
  title: string;
  description?: string;
  posture?: "read" | "lab";
  /** On a chapter: its number and title, which the top bar takes up once the page's title scrolls under it. */
  crumb?: { number: string; title: string };
}
const { title, description = "An animation course for developers: twenty-five chapters with live figures, and a lab of instruments to test what you read.", posture = "read", crumb } = Astro.props;
const fullTitle = title === "in-between" ? title : `${title} · in-between`;
const themeIds = themes.map((t) => t.id);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F5F3EE" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0F11" media="(prefers-color-scheme: dark)" />
    <script is:inline define:vars={{ themeIds }}>
      // Apply theme, mode and motion preferences before first paint (and after every page swap).
      (function () {
        function apply(doc) {
          var r = doc.documentElement;
          try {
            var t = localStorage.getItem("ib-theme");
            var mo = localStorage.getItem("ib-mode");
            var m = localStorage.getItem("ib-motion");
            // Before themes, the mode was kept under ib-theme.
            if (!mo && (t === "light" || t === "dark")) mo = t;
            if (mo === "light" || mo === "dark") r.setAttribute("data-mode", mo); else r.removeAttribute("data-mode");
            if (t && t !== "pencil" && themeIds.indexOf(t) >= 0) r.setAttribute("data-theme", t); else r.removeAttribute("data-theme");
            if (m && m !== "system") r.setAttribute("data-motion", m); else r.removeAttribute("data-motion");
          } catch (e) {}
          r.classList.add("js");
        }
        apply(document);
        if (!window.__ibPrefs) {
          window.__ibPrefs = true;
          document.addEventListener("astro:before-swap", function (e) { apply(e.newDocument); });
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class:list={[`posture-${posture}`]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="frame">
      <Header crumb={crumb} />
      {crumb && <ChapterRuler current={Number(crumb.number)} />}
      <div class="scroller" data-scroller tabindex="-1" transition:name="page" transition:animate={pageCut}>
        <main id="main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <script>
      import "~/motion/boot";
    </script>
  </body>
</html>
