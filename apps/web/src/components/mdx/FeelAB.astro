---
/** The FEEL beat: judge before numbers. See figures/FeelAB.svelte for props. */
import FeelABSvelte from "../figures/FeelAB.svelte";
const props = Astro.props as any;
---
<!-- Boxed as the numbered figures are (figures.css .plate): the versions are screens laid on it. -->
<div class="feel-plate wide">
  <FeelABSvelte client:visible {...props} />
</div>
<style>
  .feel-plate {
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--plate-bg);
    padding: clamp(0.75rem, 2.5vw, 1.5rem);
    margin-block: 2.5rem !important;
  }
</style>
