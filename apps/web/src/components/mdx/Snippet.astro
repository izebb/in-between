---
/**
 * A copyable snippet card. Put a fenced code block inside.
 * <Snippet title="03 · Spacing: arrive and settle" lab="curve-bench" easing="cubic-bezier(.2,.8,.2,1)" duration={280}>
 */
import { labUrl } from "~/lib/labstate";
import { labPreset, type LabShorthand } from "~/lib/labpresets";
import type { InstrumentId } from "~/lib/curriculum";
interface Props extends LabShorthand {
  title: string;
  lab?: InstrumentId;
}
const { title, lab, ...short } = Astro.props;
const href = lab ? labUrl(lab, labPreset(lab, { ...short, title })) : null;
---
<figure class="snippet">
  <figcaption class="snippet-head">
    <span class="smallcaps">{title}</span>
    <span class="snippet-actions">
      <button class="btn ghost small snippet-copy" type="button">Copy</button>
      {href && <a class="btn small" href={href}>Open in Lab</a>}
    </span>
  </figcaption>
  <slot />
</figure>

<script>
  function wire() {
    document.querySelectorAll<HTMLButtonElement>(".snippet-copy:not([data-wired])").forEach((b) => {
      b.dataset.wired = "";
      b.addEventListener("click", async () => {
        const pre = b.closest(".snippet")?.querySelector("pre");
        if (!pre) return;
        // The label fades in anew (the house fade), rather than swapping in place.
        const say = (text: string) => {
          const s = document.createElement("span");
          s.dataset.motion = "fade";
          s.textContent = text;
          b.replaceChildren(s);
        };
        try {
          await navigator.clipboard.writeText(pre.innerText);
          say("Copied");
          setTimeout(() => say("Copy"), 1400);
        } catch {
          /* clipboard blocked */
        }
      });
    });
  }
  document.addEventListener("astro:page-load", wire);
</script>
