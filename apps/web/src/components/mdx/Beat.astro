---
/** A section heading tagged with its beat: SEE · FEEL · TUNE · WRITE · DRILL. */
interface Props {
  kind: "see" | "feel" | "tune" | "write" | "drill" | "more";
  id?: string;
}
const order = ["see", "feel", "tune", "write", "drill"] as const;
const { kind, id } = Astro.props;
const idx = order.indexOf(kind as (typeof order)[number]);
---
{idx === -1 ? (
  <h2 id={id}><slot /></h2>
) : (
  <h2 class="beat" id={id ?? kind}>
    <span class="smallcaps" aria-hidden="true">
      {order.map((b, i) => <>{i > 0 && " · "}{i === idx ? <b>{b}</b> : <span>{b}</span>}</>)}
    </span>
    <span><slot /></span>
  </h2>
)}
