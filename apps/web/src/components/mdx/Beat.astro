---
/** A section heading for one beat of a chapter (see, feel, tune, write, drill), anchored by its beat name. */
interface Props {
  kind: "see" | "feel" | "tune" | "write" | "drill" | "more";
  id?: string;
}
const { kind, id } = Astro.props;
---
<h2 id={id ?? (kind === "more" ? undefined : kind)}><slot /></h2>
