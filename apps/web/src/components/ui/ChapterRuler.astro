---
/**
 * The chapters' navigation: the course as a tick ruler standing at the left edge of the sheet. A tick
 * per chapter, a longer one where a part begins, and the red playhead (the index title's) at the
 * chapter being read, moving down that chapter's slot as its page scrolls, so it's also where you are
 * in the course. The chapter being read is named along the ruler, like a book's spine, travelling with
 * the playhead; hovering or focusing any tick names its chapter beside it; clicking goes there.
 *
 * It persists from one chapter page to the next, so the playhead slides from the chapter you left to
 * the one you opened. Only where the sheet has a left margin for it.
 */
import { chapters, pad2 } from "~/lib/curriculum";

interface Props {
  current: number;
}
const { current } = Astro.props;
---
<nav class="ch-ruler" aria-label="Chapters" data-ch-ruler transition:persist="ch-ruler" transition:animate="none">
  <ol>
    {chapters.map((c, i) => (
      <li>
        <a
          href={`/chapters/${c.slug}`}
          class:list={["cr-tick", { "cr-part": i === 0 || chapters[i - 1].part !== c.part }]}
          aria-current={c.number === current ? "page" : undefined}
          data-n={c.number}
        >
          <span class="cr-label"><span class="cr-n">{pad2(c.number)}</span>{c.title}</span>
        </a>
      </li>
    ))}
  </ol>
  <span class="cr-head" aria-hidden="true"></span>
  <span class="cr-spine" aria-hidden="true"><span class="cr-spine-n"></span><span class="cr-spine-t"></span></span>
</nav>

<script>
  import { duration } from "~/motion/tokens";

  let listening: AbortController | null = null;

  function mount() {
    const nav = document.querySelector<HTMLElement>("[data-ch-ruler]");
    const scroller = document.querySelector<HTMLElement>("[data-scroller]");
    const head = nav?.querySelector<HTMLElement>(".cr-head");
    if (!nav || !scroller || !head) return;
    // The ruler may have come over from the last chapter: say which one this is.
    const current = Number(document.querySelector<HTMLElement>("[data-chapter]")?.dataset.chapter ?? 0);
    const ticks = [...nav.querySelectorAll<HTMLAnchorElement>(".cr-tick")];
    const middle = (t: HTMLElement) => t.offsetTop + t.offsetHeight / 2;
    ticks.forEach((t) => (Number(t.dataset.n) === current ? t.setAttribute("aria-current", "page") : t.removeAttribute("aria-current")));
    const i = ticks.findIndex((t) => Number(t.dataset.n) === current);
    if (i < 0) return;
    // Its name along the ruler: below the playhead, or above it in the ruler's lower half
    const spine = nav.querySelector<HTMLElement>(".cr-spine")!;
    const label = ticks[i].querySelector(".cr-label");
    spine.querySelector(".cr-spine-n")!.textContent = label?.querySelector(".cr-n")?.textContent ?? "";
    spine.querySelector(".cr-spine-t")!.textContent = label?.lastChild?.textContent ?? "";
    spine.classList.toggle("is-up", middle(ticks[i]) > nav.clientHeight / 2);
    // From this chapter's tick toward the next, as far as the page has been read
    const place = () => {
      const max = scroller.scrollHeight - scroller.clientHeight;
      const read = max > 0 ? scroller.scrollTop / max : 0;
      const a = middle(ticks[i]);
      const b = i < ticks.length - 1 ? middle(ticks[i + 1]) : nav.clientHeight;
      nav.style.setProperty("--y", `${(a + read * (b - a) - 1).toFixed(1)}px`); // the playhead and the spine both ride on it
    };
    // Arriving from another chapter, the playhead glides to this one; arriving fresh, it's simply there.
    if (nav.dataset.placed) {
      nav.classList.add("is-moving");
      setTimeout(() => nav.classList.remove("is-moving"), duration.scene);
    }
    place();
    nav.dataset.placed = "1";
    listening?.abort();
    listening = new AbortController();
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        place();
      });
    };
    scroller.addEventListener("scroll", onScroll, { passive: true, signal: listening.signal });
    addEventListener("resize", place, { signal: listening.signal });
  }

  document.addEventListener("astro:page-load", mount);
</script>

<style>
  .ch-ruler { display: none; }
  @media (min-width: 1000px) {
    .ch-ruler { display: block; position: absolute; z-index: 15; left: 2px; top: calc(var(--header-h) + 1.5rem); bottom: 1.5rem; width: 30px; }
  }
  .ch-ruler ol { list-style: none; margin: 0; padding: 0; height: 100%; display: flex; flex-direction: column; }
  .ch-ruler li { flex: 1; min-height: 0; }
  /* A tick per chapter; the whole slot answers the pointer */
  .cr-tick { position: relative; display: block; height: 100%; width: 100%; outline-offset: -2px; }
  .cr-tick::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 50%;
    width: 7px;
    height: 1px;
    background: var(--graphite);
    opacity: 0.7;
    transition: width var(--dur-quick) var(--ease-out), background var(--dur-quick) var(--ease-out);
  }
  .cr-tick.cr-part::before { width: 12px; opacity: 1; }
  .cr-tick[aria-current="page"]::before { width: 12px; background: var(--ink); opacity: 1; }
  .cr-tick:is(:hover, :focus-visible)::before { width: 18px; background: var(--blue-pencil); opacity: 1; }
  /* Its name, beside the tick while it's pointed at */
  .cr-label {
    position: absolute;
    left: 34px;
    top: 50%;
    translate: calc(-1 * var(--dist-nudge)) -50%;
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
    padding: 0.3rem 0.65rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 4px;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.08);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--ink);
    transition: opacity var(--dur-quick) var(--ease-out), translate var(--dur-quick) var(--ease-out);
  }
  .cr-n { font-family: var(--font-mono); font-weight: 400; font-size: 0.6875rem; color: var(--graphite); margin-right: 0.45rem; font-variant-numeric: tabular-nums; }
  .cr-tick:is(:hover, :focus-visible) .cr-label { opacity: 1; translate: 0 -50%; }
  /* The playhead: the index title's red, laid across the ruler */
  .cr-head {
    position: absolute;
    left: 1px;
    top: 0;
    width: 19px;
    height: 2px;
    border-radius: 1px;
    background: var(--red-pencil);
    translate: 0 var(--y, 0px);
    pointer-events: none;
  }
  .cr-head::after { content: ""; position: absolute; right: -4px; top: -3px; width: 8px; height: 8px; border-radius: 50%; background: var(--red-pencil); }
  /* The chapter being read, named along the ruler like a spine, riding with the playhead */
  .cr-spine {
    position: absolute;
    left: 15px;
    top: 0;
    writing-mode: vertical-rl;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--graphite-strong);
    pointer-events: none;
    translate: 0 calc(var(--y, 0px) + 12px);
  }
  .cr-spine.is-up { translate: 0 calc(var(--y, 0px) - 100% - 10px); }
  .cr-spine-n { color: var(--red-pencil); margin-inline-end: 0.7em; }
  /* While another tick is named, the spine steps back */
  .cr-spine { transition: opacity var(--dur-quick) var(--ease-out); }
  .ch-ruler:has(.cr-tick:is(:hover, :focus-visible)) .cr-spine { opacity: 0.25; }
  .ch-ruler.is-moving :is(.cr-head, .cr-spine) { transition: translate var(--dur-scene) var(--ease-inout), opacity var(--dur-quick) var(--ease-out); }
  @media (prefers-reduced-motion: reduce) {
    .ch-ruler.is-moving :is(.cr-head, .cr-spine) { transition: none; }
  }
</style>
