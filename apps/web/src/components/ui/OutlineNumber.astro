---
/**
 * A number as Geist Bold outlines (lib/outline.ts): a hairline at rest. Inside a .pencil-hover it
 * is written over in blue pencil, one figure after the other, then inked: the page titles' write-on,
 * played on hover (components.css). Each figure is two paths: the hairline, and the pencil and ink.
 */
import { numeral } from "~/lib/outline";

interface Props {
  text: string;
  class?: string;
}
const { text, class: cls } = Astro.props;
const n = numeral(text);
---
<span class:list={["o-num", cls]}>
  <span class="visually-hidden">{text}</span>
  <svg viewBox={n.viewBox} style={n.style} aria-hidden="true">
    {n.letters.map((d, i) => (
      <g style={`--k:${i}`}>
        <path class="o-hair" d={d} />
        <path class="o-ink" d={d} pathLength="1" />
      </g>
    ))}
  </svg>
</span>
