---
// The animation peg bar: a registration rule with three holes. Our one ornament.
---
<div class="pegbar-row" aria-hidden="true">
  <span class="pegbar-line"></span>
  <svg class="pegbar-holes" width="236" height="22" viewBox="0 0 236 22">
    <line class="rule" x1="0" y1="11" x2="236" y2="11" stroke-width="1" />
    <rect class="hole" x="14" y="7" width="40" height="8" rx="4" stroke-width="1" />
    <circle class="hole" cx="118" cy="11" r="5" stroke-width="1" />
    <rect class="hole" x="182" y="7" width="40" height="8" rx="4" stroke-width="1" />
  </svg>
  <span class="pegbar-line"></span>
</div>

<style>
  .pegbar-row { display: flex; align-items: center; height: 22px; }
  .pegbar-line { flex: 1; height: 1px; background: var(--rule); }
  .pegbar-holes { flex: none; overflow: visible; }
  .pegbar-holes .rule { stroke: var(--rule); }
  .pegbar-holes .hole { fill: var(--paper); stroke: var(--graphite); }
  :global(:root[data-theme="dark"]) .pegbar-holes .hole { fill: rgba(255, 248, 230, 0.12); stroke: var(--graphite); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .pegbar-holes .hole { fill: rgba(255, 248, 230, 0.12); }
  }
  @media (max-width: 480px) { .pegbar-holes { width: 180px; } }
</style>
