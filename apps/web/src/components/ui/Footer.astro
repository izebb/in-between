---
import Watch from "./Watch.svelte";

// The watch stands only at the foot of the home page.
const home = Astro.url.pathname.replace(/\/$/, "") === "";
---
<footer class="site-footer page" data-persp-self>
  <div class="foot-line">
    <span><span class="serif-italic">Inbetween</span> · a field manual and laboratory for motion on the web.</span>
    <span>
      <a href="/">Contents</a> · <a href="/lab">Lab</a> · <a href="/lab/eye-trainer">Eye trainer</a> · <a href="/tokens.figma.json">Tokens</a>
    </span>
  </div>
  <!-- A small watch keeping the reader's time, at the left. -->
  {home && <Watch client:visible />}
</footer>
