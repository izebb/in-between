---
import RotaryDial from "./RotaryDial.svelte";
import { epigraphs } from "~/lib/epigraphs";

// The dial stands only at the foot of the home page.
const home = Astro.url.pathname.replace(/\/$/, "") === "";
---
<footer class="site-footer page" data-persp-self>
  <!-- The same tick ruler as the page's other dividers, rising into view as they do; along it, a
       playhead keeps playing (motion.css .foot-rule). -->
  <div class="tick-rule foot-rule" aria-hidden="true" data-reveal-block="rule"></div>
  <div class="foot-line">
    <span><span class="wordmark-foot">in-between</span> · a field manual and laboratory for motion on the web.</span>
    <span>
      <a href="/">Contents</a> · <a href="/lab">Lab</a> · <a href="/lab/eye-trainer">Eye trainer</a> · <a href="/tokens.figma.json">Tokens</a>
    </span>
  </div>
  <!-- The epigraph's portraits (Epigraph.astro) are drawn from others' photographs: their credits. -->
  {home && (
    <p class="foot-credits">
      Portraits drawn in pencil after photographs of{" "}
      {epigraphs.map((q, i) => (
        <>
          {q.name} by <a href={q.photo.page}>{q.photo.by}</a> (<a href={q.photo.licenseUrl}>{q.photo.license}</a>){i < epigraphs.length - 1 ? "; " : "."}
        </>
      ))}{" "}
      Drawings from share-alike photographs are shared under the same licence.
    </p>
  )}
  <!-- A rotary dial standing on the bottom edge of the page: only its upper half is in view. -->
  {home && <RotaryDial client:visible />}
</footer>
