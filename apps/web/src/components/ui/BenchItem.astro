---
/**
 * A lab instrument's box, on the home page and the lab index: its code in outline figures and a small
 * pencil drawing of the tool along the top, then its name, what it does, and what it trains. On hover
 * the pencil draws the box's outline (components.css .pencil-hover), inks the code, traces the drawing
 * in blue, and "Open" takes the tag's place.
 */
import OutlineNumber from "./OutlineNumber.astro";
import { instrumentIcons } from "~/lib/instrumentIcons";
import type { InstrumentMeta } from "~/lib/curriculum";

interface Props {
  i: InstrumentMeta;
  /** Reveal this box (and its description's lines) as it comes into view, n-th in its row. */
  revealI?: number;
}
const { i, revealI } = Astro.props;
const d = instrumentIcons[i.id];
const reveal = revealI !== undefined;
---
<a class="bench-item pencil-hover" href={`/lab/${i.id}`} data-reveal-block={reveal ? "" : undefined} data-reveal-i={revealI}>
  <svg class="ph-outline" aria-hidden="true"><rect x="0.5" y="0.5" width="100%" height="100%" pathLength="1" /></svg>
  <span class="bi-head">
    <OutlineNumber class="bi-code ph-n" text={i.code} />
    <svg class="bi-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path class="bi-icon-base" d={d} />
      <path class="bi-icon-ink" d={d} pathLength="1" />
    </svg>
  </span>
  <span class="serif ph-title">{i.name}</span>
  <p data-reveal-lines={reveal ? "" : undefined} data-lines={reveal ? "" : undefined}>{i.does}</p>
  <span class="bi-foot">
    <span class="smallcaps bi-tag">{i.trains}</span>
    <span class="smallcaps bi-open" aria-hidden="true">Open →</span>
  </span>
</a>
