{
  "$description": "Inbetween design tokens. The single source of truth: compiled to src/styles/tokens.css, src/motion/tokens.ts and public/tokens.figma.json by scripts/build-tokens.mjs.",
  "color": {
    "paper": { "light": "#F5F3EE", "dark": "#0E0F11", "meaning": "background" },
    "paper-raised": { "light": "#FAF9F5", "dark": "#15161A", "meaning": "cards, panels, lab stage" },
    "paper-float": { "light": "#FEFDFA", "dark": "#1C1D22", "meaning": "tool cards floating over the lab stage" },
    "ink": { "light": "#16161A", "dark": "#ECEAE4", "meaning": "text, primary strokes" },
    "graphite": { "light": "#8A8880", "dark": "#6B6A66", "meaning": "secondary text, grid, axes" },
    "graphite-strong": { "light": "#5E5C56", "dark": "#9A9892", "meaning": "secondary text that must pass contrast" },
    "rule": { "light": "#E2DED5", "dark": "#1F2024", "meaning": "hairlines, peg-bar lines" },
    "blue-pencil": { "light": "#3D6BFF", "dark": "#7C9BFF", "meaning": "ghosts, paths, rough: what could be" },
    "red-pencil": { "light": "#FF3B1F", "dark": "#FF5A3C", "meaning": "keys, current frame: what is" },
    "glow": { "light": "rgba(255,248,230,0)", "dark": "rgba(255,248,230,.06)", "meaning": "lightbox glow under figures" }
  },
  "font": {
    "display": "\"Geist Variable\", \"Geist\", \"Helvetica Neue\", Arial, sans-serif",
    "body": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
    "mono": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, \"SF Mono\", Menlo, monospace"
  },
  "shape": {
    "radius-s": { "value": "5px", "use": "buttons, inputs, small controls" },
    "radius-m": { "value": "8px", "use": "plates, cards, popovers" },
    "radius-l": { "value": "16px", "use": "the lab stage, large panels" },
    "line": { "value": "1px", "use": "the outline of a control or a panel" },
    "blur": { "value": "none", "use": "what shows through a translucent panel" },
    "shadow-float": { "value": "0 10px 40px -18px rgb(0 0 0 / 0.35)", "use": "things that float: popovers, menus, tool cards" },
    "shadow-card": { "value": "none", "use": "cards and plates at rest" },
    "art": { "value": "none", "use": "art behind the whole page" },
    "art-size": { "value": "auto", "use": "the art's tile" }
  },
  "themes": {
    "$description": "A theme is a whole look: palette (light and dark), type, and shape. Pencil is the tokens above; each other theme overrides them. Motion is the same in every theme: it is what the chapters teach.",
    "pencil": {
      "name": "Pencil",
      "fonts": "Geist + Geist Mono",
      "note": "Paper and ink; a blue pencil for what could be, a red one for what is."
    },
    "glassy": {
      "name": "Glassy",
      "fonts": "Sora + Manrope",
      "note": "Frosted panels over soft colour. Round, light and quiet.",
      "swatch": { "light": "linear-gradient(135deg, #C3CEFF, #FFCFE0 55%, #C8F5E6)", "dark": "linear-gradient(135deg, #3B2A8A, #6B1E4F 55%, #0E5A6B)" },
      "font": {
        "display": "\"Sora Variable\", \"Sora\", system-ui, sans-serif",
        "body": "\"Manrope Variable\", \"Manrope\", system-ui, sans-serif",
        "mono": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, monospace"
      },
      "shape": { "radius-s": "10px", "radius-m": "18px", "radius-l": "26px", "line": "1px", "blur": "blur(20px) saturate(160%)" },
      "light": {
        "paper": "#EEF1F8", "paper-raised": "rgba(255,255,255,.55)", "paper-float": "rgba(255,255,255,.66)", "ink": "#1B1D29",
        "graphite": "#8A8FA3", "graphite-strong": "#555A6E", "rule": "rgba(27,29,41,.11)", "blue-pencil": "#5B68F5", "red-pencil": "#F2457E", "glow": "rgba(255,255,255,0)",
        "outline": "rgba(255,255,255,.8)",
        "shadow-float": "0 24px 60px -24px rgba(44,52,110,.38)", "shadow-card": "0 14px 36px -22px rgba(44,52,110,.32)",
        "art": "radial-gradient(40% 55% at 12% 22%, #C3CEFF 0, transparent 70%), radial-gradient(34% 50% at 88% 14%, #FFCFE0 0, transparent 70%), radial-gradient(45% 55% at 62% 96%, #C8F5E6 0, transparent 70%)",
        "art-size": "auto"
      },
      "dark": {
        "paper": "#0B0D18", "paper-raised": "rgba(255,255,255,.06)", "paper-float": "rgba(32,34,56,.62)", "ink": "#EEF0FA",
        "graphite": "#7B80A0", "graphite-strong": "#A6ABC8", "rule": "rgba(255,255,255,.1)", "blue-pencil": "#8F9BFF", "red-pencil": "#FF7AA8", "glow": "rgba(160,140,255,.06)",
        "outline": "rgba(255,255,255,.14)",
        "shadow-float": "0 24px 60px -24px rgba(0,0,0,.7)", "shadow-card": "0 14px 36px -22px rgba(0,0,0,.6)",
        "art": "radial-gradient(40% 55% at 12% 22%, rgba(98,70,255,.5) 0, transparent 70%), radial-gradient(34% 50% at 88% 14%, rgba(255,80,150,.32) 0, transparent 70%), radial-gradient(45% 55% at 62% 96%, rgba(0,190,170,.3) 0, transparent 70%)",
        "art-size": "auto"
      }
    },
    "mono": {
      "name": "Mono",
      "fonts": "JetBrains Mono",
      "note": "Your editor: mono type, syntax colour, square corners.",
      "font": {
        "display": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, monospace",
        "body": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, monospace",
        "mono": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, monospace"
      },
      "shape": { "radius-s": "3px", "radius-m": "4px", "radius-l": "6px", "line": "1px", "blur": "none" },
      "light": {
        "paper": "#FFFFFF", "paper-raised": "#F6F8FA", "paper-float": "#FFFFFF", "ink": "#1F2328",
        "graphite": "#818B98", "graphite-strong": "#59636E", "rule": "#D1D9E0", "blue-pencil": "#0969DA", "red-pencil": "#CF222E", "glow": "rgba(255,255,255,0)",
        "outline": "#D1D9E0",
        "shadow-float": "0 8px 24px rgba(140,149,159,.2)", "shadow-card": "none",
        "art": "none", "art-size": "auto"
      },
      "dark": {
        "paper": "#0D1117", "paper-raised": "#161B22", "paper-float": "#1C2128", "ink": "#E6EDF3",
        "graphite": "#6E7681", "graphite-strong": "#9198A1", "rule": "#30363D", "blue-pencil": "#58A6FF", "red-pencil": "#FF7B72", "glow": "rgba(255,255,255,0)",
        "outline": "#30363D",
        "shadow-float": "0 8px 24px rgba(1,4,9,.8)", "shadow-card": "none",
        "art": "none", "art-size": "auto"
      }
    },
    "cartoon": {
      "name": "Cartoon",
      "fonts": "Fredoka + Nunito",
      "note": "Thick outlines, bold colour, a friendly round hand.",
      "font": {
        "display": "\"Fredoka Variable\", \"Fredoka\", system-ui, sans-serif",
        "body": "\"Nunito Variable\", \"Nunito\", system-ui, sans-serif",
        "mono": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, monospace"
      },
      "shape": { "radius-s": "12px", "radius-m": "16px", "radius-l": "24px", "line": "2px", "blur": "none" },
      "light": {
        "paper": "#FFF4D6", "paper-raised": "#FFFFFF", "paper-float": "#FFFFFF", "ink": "#1D1B2E",
        "graphite": "#8E88A8", "graphite-strong": "#4B4768", "rule": "#E6D7AE", "blue-pencil": "#3D7BFF", "red-pencil": "#FF4F6D", "glow": "rgba(255,255,255,0)",
        "outline": "#1D1B2E",
        "shadow-float": "5px 5px 0 #1D1B2E", "shadow-card": "4px 4px 0 #1D1B2E",
        "art": "radial-gradient(circle at 2px 2px, rgba(29,27,46,.13) 1.5px, transparent 2px)", "art-size": "22px 22px"
      },
      "dark": {
        "paper": "#241C45", "paper-raised": "#2F2656", "paper-float": "#362C62", "ink": "#FFF4D6",
        "graphite": "#9A90C4", "graphite-strong": "#D2C9F0", "rule": "#3F3570", "blue-pencil": "#7FA8FF", "red-pencil": "#FF6B85", "glow": "rgba(255,255,255,0)",
        "outline": "#0D0920",
        "shadow-float": "5px 5px 0 #0D0920", "shadow-card": "4px 4px 0 #0D0920",
        "art": "radial-gradient(circle at 2px 2px, rgba(255,244,214,.1) 1.5px, transparent 2px)", "art-size": "22px 22px"
      }
    }
  },
  "duration": {
    "instant": { "value": 90, "use": "press states, toggles" },
    "quick": { "value": 180, "use": "hovers, small reveals" },
    "base": { "value": 280, "use": "panels, cards" },
    "scene": { "value": 480, "use": "page and chapter transitions" }
  },
  "exitRatio": 0.7,
  "easing": {
    "out": { "value": [0.2, 0.8, 0.2, 1], "use": "enter" },
    "in": { "value": [0.4, 0, 1, 1], "use": "exit (exits are faster: ~0.7× enter)" },
    "inout": { "value": [0.65, 0, 0.35, 1], "use": "on-screen moves" },
    "reveal": { "value": [0.16, 1, 0.3, 1], "use": "masked text reveals (expo-out): lines rising out of a mask" }
  },
  "spring": {
    "snappy": { "response": 0.3, "bounce": 0, "use": "direct manipulation" },
    "soft": { "response": 0.5, "bounce": 0.15, "use": "playful confirmations" }
  },
  "distance": {
    "rise": { "value": 4, "use": "page cut, figure reveal" },
    "nudge": { "value": 8, "use": "small enters: tooltips, menus" },
    "travel": { "value": 24, "use": "panels arriving from an edge" }
  },
  "stagger": {
    "step": { "value": 30, "use": "delay between siblings (20–40ms reads as one gesture)" }
  }
}
