{
  "$description": "Inbetween design tokens. The single source of truth: compiled to src/styles/tokens.css, src/motion/tokens.ts and public/tokens.figma.json by scripts/build-tokens.mjs.",
  "color": {
    "paper": { "light": "#F5F3EE", "dark": "#0E0F11", "meaning": "background" },
    "paper-raised": { "light": "#FAF9F5", "dark": "#15161A", "meaning": "cards, panels, lab stage" },
    "ink": { "light": "#16161A", "dark": "#ECEAE4", "meaning": "text, primary strokes" },
    "graphite": { "light": "#8A8880", "dark": "#6B6A66", "meaning": "secondary text, grid, axes" },
    "graphite-strong": { "light": "#5E5C56", "dark": "#9A9892", "meaning": "secondary text that must pass contrast" },
    "rule": { "light": "#E2DED5", "dark": "#1F2024", "meaning": "hairlines, peg-bar lines" },
    "blue-pencil": { "light": "#3D6BFF", "dark": "#7C9BFF", "meaning": "ghosts, paths, rough: what could be" },
    "red-pencil": { "light": "#FF3B1F", "dark": "#FF5A3C", "meaning": "keys, current frame: what is" },
    "glow": { "light": "rgba(255,248,230,0)", "dark": "rgba(255,248,230,.06)", "meaning": "lightbox glow under figures" }
  },
  "font": {
    "display": "\"Geist Variable\", \"Geist\", \"Helvetica Neue\", Arial, sans-serif",
    "body": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
    "mono": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, \"SF Mono\", Menlo, monospace"
  },
  "duration": {
    "instant": { "value": 90, "use": "press states, toggles" },
    "quick": { "value": 180, "use": "hovers, small reveals" },
    "base": { "value": 280, "use": "panels, cards" },
    "scene": { "value": 480, "use": "page and chapter transitions" }
  },
  "exitRatio": 0.7,
  "easing": {
    "out": { "value": [0.2, 0.8, 0.2, 1], "use": "enter" },
    "in": { "value": [0.4, 0, 1, 1], "use": "exit (exits are faster: ~0.7× enter)" },
    "inout": { "value": [0.65, 0, 0.35, 1], "use": "on-screen moves" },
    "reveal": { "value": [0.16, 1, 0.3, 1], "use": "masked text reveals (expo-out): lines rising out of a mask" }
  },
  "spring": {
    "snappy": { "response": 0.3, "bounce": 0, "use": "direct manipulation" },
    "soft": { "response": 0.5, "bounce": 0.15, "use": "playful confirmations" }
  },
  "distance": {
    "rise": { "value": 4, "use": "page cut, figure reveal" },
    "nudge": { "value": 8, "use": "small enters: tooltips, menus" },
    "travel": { "value": 24, "use": "panels arriving from an edge" }
  },
  "stagger": {
    "step": { "value": 30, "use": "delay between siblings (20–40ms reads as one gesture)" }
  }
}
