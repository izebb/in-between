---
import Base from "~/layouts/Base.astro";
import { getCollection } from "astro:content";
import { chapters, parts, pad2, instruments } from "~/lib/curriculum";
import TitleScrub from "~/components/ui/TitleScrub.svelte";
import OutlineNumber from "~/components/ui/OutlineNumber.astro";

const written = new Set((await getCollection("chapters")).map((c) => c.id));
const byPart = parts.map((p) => ({ part: p, items: chapters.filter((c) => c.part === p.numeral) }));
---
<Base title="Inbetween">
  <div class="page index">
    <section class="hero" data-reveal-section>
      <p class="smallcaps kicker">A field manual and laboratory for motion on the web</p>
      <TitleScrub client:load />
      <div class="hero-grid">
        <!-- The word the site is named for, defined as a dictionary defines it. Each part rises out of its
             mask after the last. -->
        <div class="dict" id="intro">
          <p class="dict-head smallcaps" id="dict-head" data-reveal-lines data-lines data-reveal-delay="quick">Definition</p>
          <ol class="dict-senses" role="list">
            <li id="sense-1" data-reveal-lines data-lines data-reveal-after="#dict-head"><span class="dict-n">1</span> A frame drawn between two keys.</li>
            <li id="sense-2" data-reveal-lines data-lines data-reveal-after="#sense-1"><span class="dict-n">2</span> The part of a motion that decides how it feels.</li>
          </ol>
          <p class="dict-see" id="dict-see" data-reveal-lines data-lines data-reveal-after="#sense-2">
            <span class="smallcaps dict-see-label">See also</span>
            <span><a href="/chapters/02-timing">timing</a>,</span> <span><a href="/chapters/03-spacing">spacing</a>,</span>
            <a href="/chapters/15-easing-by-hand">easing</a>
          </p>
        </div>
        <!-- An epigraph, set as a book sets one: small, in the reading face, ranged right, attributed.
             Its lines rise out of their masks once it comes into view (patterns.ts revealLines). -->
        <figure class="epigraph" data-reveal-lines data-reveal-after="#dict-see">
          <blockquote>
            <p data-lines>“Animation is not the art of drawings that move, but the art of movements that are drawn.”</p>
          </blockquote>
          <figcaption><span class="dash">—</span> <span class="smallcaps">Norman McLaren</span></figcaption>
        </figure>
      </div>
    </section>
    <section class="toc" aria-labelledby="contents-h">
      <!-- The divider carries its label: "Contents" at its left, the tick ruler running on from it. -->
      <div class="toc-head" data-persp-self>
        <h2 id="contents-h" class="smallcaps toc-title" data-reveal-block>Contents</h2>
        <div class="tick-rule" aria-hidden="true" data-reveal-block="rule"></div>
      </div>
      {byPart.map(({ part, items }) => (
        <div class="toc-part">
          <div class="part-head" data-reveal-block data-persp-self>
            <span class="smallcaps part-n">{part.numeral === "—" ? "Capstone" : `Part ${part.numeral}`}</span>
            <h3 class="part-title serif">{part.title}</h3>
            <p class="part-blurb" data-reveal-lines data-lines>{part.blurb}</p>
          </div>
          <ol class="rows" role="list" data-persp>
            {items.map((c, ci) => {
              const live = written.has(c.slug);
              const Tag = live ? "a" : "div";
              return (
                <li>
                  <Tag class:list={["row", { soon: !live, "pencil-hover": live }]} href={live ? `/chapters/${c.slug}` : undefined} data-specimen-row data-reveal-block data-reveal-i={ci + 1}>
                    {live && <svg class="ph-outline" aria-hidden="true"><rect x="0.5" y="0.5" width="100%" height="100%" pathLength="1" /></svg>}
                    <OutlineNumber class="row-n ph-n" text={pad2(c.number)} />
                    <span class="row-text">
                      <span class="row-title serif ph-title">{c.title}</span>
                      <span class="row-sum" data-reveal-lines data-lines>{c.summary}</span>
                    </span>
                    <canvas class="specimen" data-specimen={c.specimen} width="128" height="36" aria-hidden="true" />
                  </Tag>
                </li>
              );
            })}
          </ol>
        </div>
      ))}
    </section>

    <section class="bench" aria-labelledby="lab-h">
      <!-- The same divider as the contents: its label at the left, the tick ruler running on from it. -->
      <div class="toc-head bench-head" data-persp-self>
        <h2 id="lab-h" class="smallcaps toc-title" data-reveal-block>Lab</h2>
        <div class="tick-rule" aria-hidden="true" data-reveal-block="rule"></div>
      </div>
      <div class="bench-list" data-persp>
        {instruments.map((i, ii) => (
          <a class="bench-item pencil-hover" href={`/lab/${i.id}`} data-reveal-block data-reveal-i={ii % 3}>
            <svg class="ph-outline" aria-hidden="true"><rect x="0.5" y="0.5" width="100%" height="100%" pathLength="1" /></svg>
            <span class="smallcaps ph-n">{i.code}</span>
            <span class="serif ph-title">{i.name}</span>
            <p data-reveal-lines data-lines>{i.does}</p>
            <span class="smallcaps trains">Trains · {i.trains}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<script>
  import { createLoop, type Loop } from "@inbetween/core";
  import { specimens, readPencils } from "~/lib/specimens";
  import { vignettes, readPalette, VW, VH } from "~/lib/vignettes";
  import { prefersReducedMotion } from "~/motion/policy";

  /**
   * Each chapter row's picture: an illustrated vignette (lib/vignettes.ts) where one exists, else the
   * older spacing-chart specimen. At rest it shows its designed pose; on hover it plays its loop.
   */
  function setup() {
    const canvases = [...document.querySelectorAll<HTMLCanvasElement>("canvas[data-specimen]")];
    if (!canvases.length) return;
    const dpr = Math.min(2, devicePixelRatio || 1);
    let pencils = readPencils();
    let palette = readPalette();

    const draw = (cv: HTMLCanvasElement, t: number | null) => {
      const key = cv.dataset.specimen!;
      const ctx = cv.getContext("2d");
      if (!ctx) return;
      const vig = vignettes[key];
      const w = vig ? VW : 128, h = vig ? VH : 36;
      if (cv.width !== w * dpr) { cv.width = w * dpr; cv.height = h * dpr; cv.style.width = `${w}px`; cv.style.height = `${h}px`; }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      if (vig) vig.draw({ ctx, w, h, c: palette }, t);
      else specimens[key]?.({ ctx, w, h, c: pencils }, t === null ? null : t);
    };
    const drawAllStill = () => { pencils = readPencils(); palette = readPalette(); canvases.forEach((c) => draw(c, null)); };
    drawAllStill();
    if (import.meta.env.DEV) (window as unknown as { __ibDraw: typeof draw }).__ibDraw = draw; // for frame-by-frame checks

    let loop: Loop | null = null;
    const stop = (cv: HTMLCanvasElement) => { loop?.stop(); loop = null; draw(cv, null); };
    document.querySelectorAll<HTMLElement>("[data-specimen-row]").forEach((row) => {
      const cv = row.querySelector<HTMLCanvasElement>("canvas")!;
      const period = vignettes[cv.dataset.specimen!]?.period ?? 1.2;
      const start = () => {
        if (prefersReducedMotion()) return;
        loop?.stop();
        loop = createLoop(({ time }) => draw(cv, (time % period) / period));
      };
      row.addEventListener("pointerenter", start);
      row.addEventListener("focus", start);
      row.addEventListener("pointerleave", () => stop(cv));
      row.addEventListener("blur", () => stop(cv));
    });
    addEventListener("ib:prefs", drawAllStill);
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", drawAllStill);
  }
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .index { padding-bottom: 2rem; }
  .hero { padding-block: clamp(2.5rem, 8vw, 6rem) clamp(2rem, 5vw, 3.5rem); }
  .kicker { color: var(--graphite-strong); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 36rem) minmax(0, 20rem); justify-content: space-between; gap: 2rem 4rem; margin-top: 2rem; align-items: end; }
  /* The intro, as a dictionary entry: a label, numbered senses in the reading mono hanging from their
     numbers, and a see-also line aligned with the senses. */
  .dict { --hang: 1.75rem; color: var(--ink); }
  .dict-head { color: var(--graphite); }
  .dict-senses { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.35rem; }
  .dict-senses li { font-size: 1.125rem; line-height: 1.55; padding-left: var(--hang); text-indent: calc(-1 * var(--hang)); }
  /* Less the word space after it (1ch in the mono), so the text starts at the hang, where wrapped
     lines and the see-also line start too. */
  .dict-n { display: inline-block; width: calc(var(--hang) - 1ch); text-indent: 0; color: var(--graphite); font-variant-numeric: tabular-nums; }
  /* While a sense is split into masked lines, only its first line hangs from the number. */
  .dict-senses :global(.rl-mask) { text-indent: 0; }
  .dict-senses :global(.rl-mask:first-child) { text-indent: calc(-1 * var(--hang)); clip-path: inset(-0.5em -1em 0 calc(-1 * var(--hang) - 1em)); }
  .dict-see { margin-top: 1.1rem; padding-left: var(--hang); font-size: var(--text-sm); color: var(--graphite-strong); }
  .dict-see-label { color: var(--graphite); margin-right: 0.5rem; }
  .dict-see a { color: inherit; }
  /* The epigraph, as a book sets one: a short block in the reading face, a size down, hanging quote,
     attribution ranged right beneath it. */
  .epigraph { margin: 0; justify-self: end; max-width: 25ch; }
  .epigraph blockquote { margin: 0; }
  .epigraph p { font-size: 0.875rem; line-height: 1.6; color: var(--graphite-strong); text-indent: -1ch; }
  .epigraph figcaption { margin-top: 0.6rem; text-align: right; color: var(--graphite); font-size: 0.875rem; }
  .epigraph .dash { margin-right: 0.15em; }
  /* While its lines are masked for the reveal, only the first keeps the hanging quote. */
  .epigraph :global(.rl-mask) { text-indent: 0; }
  .epigraph :global(.rl-mask:first-child) { text-indent: -1ch; }


  .toc-head { display: flex; align-items: baseline; gap: 1rem; }
  /* The ruler has no text, so its baseline is its bottom edge: the label sits on the ruler's line. */
  .toc-head .tick-rule { flex: 1; min-width: 0; }
  .toc-title { color: var(--graphite-strong); line-height: 1; }
  .toc-part { display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); gap: 1rem 3rem; padding-block: 2rem; }
  /* The camera sits at the page's middle: rows are right of it (past the 15rem part column), the part
     heads left of it (the middle of the 15rem column, from half the content width). */
  .toc-part .rows { --persp-dx: -9rem; }
  .part-head { --persp-dx: calc(min(50vw - var(--frame-inset) - var(--gutter), 620px - var(--gutter)) - 7.5rem); }
  .part-head { position: sticky; top: calc(var(--header-h) + 1rem); align-self: start; }
  .part-n { color: var(--graphite); }
  .part-title { font-size: 1.75rem; line-height: 1.1; margin-top: 0.3rem; }
  .part-blurb { font-size: var(--text-sm); color: var(--graphite-strong); margin-top: 0.4rem; line-height: 1.45; }

  .rows { margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 176px;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0.5rem;
    margin-inline: -0.5rem;
    text-decoration: none;
    border-radius: 4px;
  }
  /* The number: outline figures (OutlineNumber), a hairline at rest, inked in blue pencil on hover. */
  .row :global(.row-n) { font-size: 2.25rem; color: var(--ph-n, var(--graphite)); --o-hair: 28; }
  .row-text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .row-title { font-size: 1.4rem; line-height: 1.15; }
  .row-sum { font-size: var(--text-sm); color: var(--graphite-strong); line-height: 1.4; }
  .specimen { width: 128px; height: 36px; }
  .row.soon { opacity: 0.45; }
  .row.soon .row-title::after { content: " · in preparation"; font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--graphite); }

  .bench { padding-top: 4rem; }
  .bench-head { margin-bottom: 2rem; }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .toc-part { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    .toc-part .rows, .part-head { --persp-dx: 0px; }
    .part-head { position: static; }
  }
  @media (max-width: 560px) {
    .row { grid-template-columns: 2.75rem minmax(0, 1fr); }
    .row :global(.row-n) { font-size: 1.75rem; --o-hair: 36; }
    .specimen { grid-column: 2; width: 128px; }
    .row-title { font-size: 1.25rem; }
  }
</style>
