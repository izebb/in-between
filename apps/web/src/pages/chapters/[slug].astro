---
import Base from "~/layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { chapterBySlug, chapters, pad2, partOf, instrumentById } from "~/lib/curriculum";
import { mdxComponents } from "~/components/mdx";
import LineTitle from "~/components/ui/LineTitle.astro";
import LabButton from "~/components/ui/LabButton.astro";

export async function getStaticPaths() {
  const entries = await getCollection("chapters");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const meta = chapterBySlug(entry.id)!;
const part = partOf(meta);
const { Content } = await render(entry);
const written = new Set((await getCollection("chapters")).map((c) => c.id));
const idx = chapters.findIndex((c) => c.slug === meta.slug);
const prev = chapters.slice(0, idx).reverse().find((c) => written.has(c.slug));
const next = chapters.slice(idx + 1).find((c) => written.has(c.slug));
---
<Base title={`${pad2(meta.number)} ${meta.title}`} description={meta.summary} crumb={{ number: pad2(meta.number), title: meta.title }}>
  <article class="page chapter" data-chapter={meta.number}>
    <!-- The opener: the part on the tick ruler, and where this chapter falls; the title on one line,
         written on as the index title is, its number in outline figures level with it (LineTitle); the
         lede; a button into each lab instrument it uses (LabButton). -->
    <header class="chapter-head prose" data-reveal-section>
      <div class="ch-main">
        <div class="ch-top smallcaps">
          <span>{part.numeral === "—" ? "Capstone" : `Part ${part.numeral} · ${part.title}`}</span>
          <div class="tick-rule" aria-hidden="true" data-reveal-block="rule"></div>
          <span class="ch-count">{pad2(meta.number)} / {chapters.length}</span>
        </div>
        <h1 class="ch-title ink-h" data-crumb-anchor><LineTitle text={meta.title} number={pad2(meta.number)} /></h1>
        <p class="lede" data-reveal-lines data-lines data-reveal-delay="base">{entry.data.lede}</p>
        <div class="ch-lab">
          {meta.instruments.map((id) => <LabButton i={instrumentById(id)} />)}
        </div>
      </div>
    </header>
    <div class="prose chapter-body" data-reveal-block data-persp>
      <Content components={mdxComponents} />
    </div>
    <nav class="pager prose" aria-label="Chapters">
      {prev && (
        <a class="prev" href={`/chapters/${prev.slug}`}>
          <span class="smallcaps">← {pad2(prev.number)}</span>
          <span class="serif">{prev.title}</span>
        </a>
      )}
      {next && (
        <a class="next" href={`/chapters/${next.slug}`}>
          <span class="smallcaps">{pad2(next.number)} →</span>
          <span class="serif">{next.title}</span>
        </a>
      )}
    </nav>
  </article>
</Base>

<script>
  import { markChapterRead } from "~/lib/store";
  document.addEventListener("astro:page-load", () => {
    const el = document.querySelector<HTMLElement>("[data-chapter]");
    if (el) markChapterRead(Number(el.dataset.chapter));
  });
</script>
