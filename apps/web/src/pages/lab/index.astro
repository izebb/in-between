---
import Base from "~/layouts/Base.astro";
import { instruments } from "~/lib/curriculum";
import InkTitle from "~/components/ui/InkTitle.astro";
import BenchItem from "~/components/ui/BenchItem.astro";
---
<Base title="The Lab" posture="lab">
  <div class="page">
    <header class="chapter-head" data-reveal-section>
      <span class="smallcaps part">The Lab</span>
      <InkTitle as="h1" text="A bench of instruments" />
      <p class="lede" data-reveal-lines data-lines>Every lesson opens one of these, pre-configured. Parameters on the left, stage in the centre, time underneath, code on the right.</p>
    </header>
    <div class="bench-list" data-reveal-block data-persp>
      {instruments.map((i) => <BenchItem i={i} />)}
    </div>
  </div>
</Base>
